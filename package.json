{
  "name": "@electrolux-oss/sanity-plugin-media",
  "version": "3.0.0",
  "keywords": [
    "sanity",
    "cms",
    "headless",
    "realtime",
    "content",
    "sanity-plugin",
    "asset",
    "browser",
    "electrolux"
  ],
  "homepage": "https://github.com/electrolux-oss/sanity-plugin-media",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/electrolux-oss/sanity-plugin-media.git"
  },
  "license": "MIT",
  "author": "Philip Åkerfeldt",
  "contributors": [
    {
      "name": "Philip Åkerfeldt",
      "url": "https://www.npmjs.com/~philip.akerfeldt"
    }
  ],
  "sideEffects": false,
  "type": "commonjs",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js",
      "default": "./dist/index.mjs"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pkg-utils build --strict --check --clean",
    "clean": "rimraf dist",
    "dev": "sanity dev",
    "format": "prettier --write --cache --ignore-unknown .",
    "link-watch": "plugin-kit link-watch",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "prepack": "npm run build",
    "watch": "pkg-utils watch --strict"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "dependencies": {
    "@hookform/resolvers": "^3.1.1",
    "@reduxjs/toolkit": "^2.11.2",
    "@sanity/client": "^6.28.3",
    "@sanity/color": "^3.0.6",
    "@sanity/icons": "^3.7.0",
    "@sanity/incompatible-plugin": "^1.0.5",
    "@sanity/ui": "^3.0.5",
    "@sanity/uuid": "^3.0.1",
    "@tanem/react-nprogress": "^5.0.55",
    "copy-to-clipboard": "^3.3.1",
    "date-fns": "^4.0.0",
    "filesize": "^9.0.0",
    "groq": "^3.0.0",
    "is-hotkey-esm": "^1.0.0",
    "nanoid": "^3.3.8",
    "pluralize": "^8.0.0",
    "react-dropzone": "^11.3.1",
    "react-file-icon": "^1.6.0",
    "react-hook-form": "^7.68.0",
    "react-redux": "^9.2.0",
    "react-select": "^5.10.1",
    "react-virtuoso": "^4.17.0",
    "redux": "^5.0.1",
    "redux-observable": "3.0.0-rc.2",
    "rxjs": "^7.8.1",
    "zod": "^3.21.4"
  },
  "devDependencies": {
    "@sanity/pkg-utils": "^8.1.12",
    "@sanity/plugin-kit": "^4.0.19",
    "@types/is-hotkey": "^0.1.10",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^19.0.12",
    "@types/react-dom": "^19.0.4",
    "@types/react-file-icon": "^1.0.4",
    "@typescript-eslint/eslint-plugin": "^5.62.0",
    "@typescript-eslint/parser": "^5.62.0",
    "conventional-changelog-conventionalcommits": "^5.0.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^8.10.0",
    "eslint-config-sanity": "^6.0.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^4.6.2",
    "prettier": "^2.8.8",
    "prettier-plugin-packagejson": "^2.5.20",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "react-is": "^19.2.3",
    "rimraf": "^3.0.2",
    "sanity": "^4.21.1",
    "standard-version": "^9.5.0",
    "styled-components": "^6.1.16",
    "typescript": "5.8.2"
  },
  "peerDependencies": {
    "react": "^18.3 || >=19.2.3 < 20",
    "react-dom": "^18.3 || >=19.2.3 < 20",
    "react-is": "^18.3 || >=19.2.3 < 20",
    "sanity": "^4.0.0-0 || ^5.0.0-0",
    "styled-components": "^6.1"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public"
  }
}
