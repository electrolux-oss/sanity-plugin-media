    "@sanity/ui": "^3.5.0",
    "@sanity/uuid": "^3.0.1",
    "@tanem/react-nprogress": "^5.0.63",
    "copy-to-clipboard": "^3.3.1",
    "date-fns": "^4.0.0",
    "filesize": "^9.0.0",
    "groq": "^6.7.0",
    "is-hotkey-esm": "^1.0.0",
    "nanoid": "^3.3.8",
    "pluralize": "^8.0.0",
