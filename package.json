{
  "name": "@electrolux-oss/sanity-plugin-media",
  "version": "4.0.0",
  "keywords": [
    "sanity",
    "cms",
    "headless",
    "realtime",
    "content",
    "sanity-plugin",
    "asset",
    "browser",
    "electrolux"
  ],
  "homepage": "https://github.com/electrolux-oss/sanity-plugin-media",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/electrolux-oss/sanity-plugin-media.git"
  },
  "license": "MIT",
  "author": "Philip Åkerfeldt",
  "contributors": [
    {
      "name": "Philip Åkerfeldt",
      "url": "https://www.npmjs.com/~philip.akerfeldt"
    }
  ],
  "sideEffects": false,
  "type": "module",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
