{
  "name": "@electrolux-oss/sanity-plugin-media",
  "version": "5.0.1",
  "keywords": [
    "asset",
    "browser",
    "cms",
    "content",
    "electrolux",
    "headless",
    "realtime",
    "sanity",
    "sanity-plugin"
  ],
  "homepage": "https://github.com/electrolux-oss/sanity-plugin-media",
  "license": "MIT",
  "author": "Philip Åkerfeldt",
  "contributors": [
    {
      "name": "Philip Åkerfeldt",
      "url": "https://www.npmjs.com/~philip.akerfeldt"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/electrolux-oss/sanity-plugin-media.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    },
    "access": "public"
  },
  "scripts": {
    "build": "plugin-kit verify-package --silent && pkg-utils build --strict --check",
    "clean": "rimraf dist",
    "dev": "sanity dev",
    "format": "oxfmt",
    "link-watch": "plugin-kit link-watch",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "watch": "pkg-utils watch --strict"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.2",
    "@reduxjs/toolkit": "^2.11.2",
    "@sanity/client": "^8.9.0",
    "@sanity/color": "^3.0.6",
    "@sanity/ui": "^4.4.9",
    "@sanity/uuid": "^3.0.1",
    "@tanem/react-nprogress": "^5.0.63",
    "copy-to-clipboard": "^3.3.1",
    "date-fns": "^4.0.0",
    "filesize": "^9.0.0",
    "groq": "^6.7.0",
    "is-hotkey-esm": "^1.0.0",
    "nanoid": "^3.3.8",
    "pluralize": "^8.0.0",
    "react-dropzone": "^11.3.1",
    "react-file-icon": "^1.6.0",
    "react-hook-form": "^7.71.1",
    "react-redux": "^9.2.0",
    "react-select": "^5.10.1",
    "react-virtuoso": "^4.18.1",
    "redux-observable": "^3.0.0-rc.3",
    "rxjs": "^7.8.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@sanity/icons": "^5.2.3",
    "@sanity/pkg-utils": "^13.0.16",
    "@sanity/plugin-kit": "^10.1.0",
    "@types/pluralize": "^0.0.33",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.0.4",
    "@types/react-file-icon": "^1.0.4",
    "baseline-browser-mapping": "^2.10.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.91.0",
    "oxlint-tsgolint": "^7.0.2005",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-is": "^19.2.4",
    "rimraf": "^6.1.3",
    "sanity": "^6.21.0",
    "styled-components": "^6.3.11",
    "typescript": "~6.0.3"
  },
  "peerDependencies": {
    "react": "^19.2.2",
    "react-dom": "^19.2.2",
    "sanity": "^6.20.0",
    "styled-components": "^6.1.15"
  },
  "browserslist": "extends @sanity/browserslist-config",
  "engines": {
    "node": ">=22.12"
  },
  "inlinedDependencies": {
    "@sanity/icons": "5.2.3",
    "redux": "5.0.1"
  },
  "sanityPlugin": {
    "verifyPackage": {
      "nodeEngine": false,
      "scripts": false
    }
  }
}
